            { "text": " coat? ", "textStyle": "italic" },
            { "text": "She left ", "textStyle": "italic", "newLine": true },
            { "text": "her", "textStyle": "underline" },
            { "text": " keys on the table.", "textStyle": "italic" },
            { "text": "Unlike regular adjectives, possessives don't change for plural nouns:", "textStyle": "text", "newParagraph": true },
            { "text": "my shoe / my shoes", "textStyle": "italic" },
